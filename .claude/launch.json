{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000"],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "backend-uigate",
      "runtimeExecutable": "../.venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "..", "--port", "8000"],
      "cwd": "backend/.ui-gate-db",
      "port": 8000
    }
  ]
}
